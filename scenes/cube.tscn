[sub_resource type="Shader" id="Shader_63awq"]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_toon, specular_toon;

uniform vec4 albedo : source_color;
uniform sampler2D color_gradient;
uniform sampler2D fresnel_gradient;
uniform sampler2D texture_pattern;

float fresnel(float amount, vec3 normal, vec3 view) {
	return pow((1.0 - clamp(dot(normalize(normal), normalize(view)), 0.0, 1.0)), (amount / 0.25));
}

void vertex() {
	// Called for every vertex the material is visible on.
}

void fragment() {
	// Sample the texture color from the albedo_texture at the UV coordinates
    vec4 texture_color = texture(texture_pattern, UV);
	vec3 final_color = albedo.rgb * texture_color.rgb;
	
	float basic_fresnel = fresnel(4.0, NORMAL, VIEW);
	// Get a lighter version of the albedo color
    vec3 lightAlbedoColor = albedo.rgb * 3.0; // Adjust the multiplier to make it lighter or darker
    // Combine the albedo color with the fresnel effect
    ALBEDO = final_color + (basic_fresnel * lightAlbedoColor * texture(fresnel_gradient, vec2(basic_fresnel, 0.0)).rgb);
}

void light() {
	// Called for every pixel for every light affecting the material.
	float dotproduct = clamp(dot(NORMAL, LIGHT), -0.9, 0.9);
	float sample = clamp((dotproduct + 1.0) * ATTENUATION / 2.1, 0.05, 0.95);
	vec4 shaded = texture(color_gradient, vec2(sample, 0.0));
	DIFFUSE_LIGHT += clamp((shaded.rgb * LIGHT_COLOR), 0.0, 1.0);
}
"

